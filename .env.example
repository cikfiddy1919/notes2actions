# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ELEVENLABS_API_KEY=
# Optional; defaults to a premade voice.
ELEVENLABS_VOICE_ID=
# Optional; processed notes are POSTed here after saving.
N8N_WEBHOOK_URL=
# Optional; comma-separated exact origins allowed to call the API cross-origin
# (e.g. https://app.example.com,http://localhost:5173). Unset = same-origin only. No "*".
ALLOWED_ORIGINS=
